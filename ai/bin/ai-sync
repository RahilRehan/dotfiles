#!/usr/bin/env bash
# Generate MCP configuration from ai/mcp/servers.json.
# The registry is the only file to edit; generated files are disposable.
set -euo pipefail

AI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVERS_JSON="$AI_DIR/mcp/servers.json"
MARKER_BEGIN="# BEGIN dotfiles-ai-mcp"
MARKER_END="# END dotfiles-ai-mcp"

require_jq() {
    command -v jq >/dev/null 2>&1 || {
        echo "ai-sync requires jq (brew install jq)" >&2
        exit 1
    }
}

build_json() {
    local tool="$1"
    jq -c --arg tool "$tool" '
        {mcpServers: (
            .servers
            | to_entries
            | map(select((.value.tools // []) | index($tool)))
            | map({key: .key, value: .value.config})
            | from_entries
        )}
    ' "$SERVERS_JSON"
}

write_json() {
    local tool="$1" destination="$2"
    mkdir -p "$(dirname "$destination")"
    build_json "$tool" | jq '.' > "$destination"
    echo "MCP ($tool): $destination"
}

link_agent_json() {
    local source="$1" destination="$2"
    mkdir -p "$(dirname "$destination")"
    if [[ -e "$destination" && ! -L "$destination" ]]; then
        echo "MCP: refusing to replace existing $destination; generated file is at $source" >&2
        return
    fi
    ln -sfn "$source" "$destination"
}

sync_codex() {
    local destination="$HOME/.codex/config.toml"
    local fragment temporary
    fragment="$(mktemp)"
    temporary="$(mktemp)"

    {
        echo "$MARKER_BEGIN"
        jq -r --arg tool codex '
            .servers
            | to_entries
            | map(select((.value.tools // []) | index($tool)))
            | .[]
            | "[mcp_servers.\(.key)]",
              (if .value.config.command then "command = \"\(.value.config.command)\"" else empty end),
              (if .value.config.args then "args = [" + (.value.config.args | map("\"" + . + "\"") | join(", ")) + "]" else empty end),
              (if .value.config.url then "url = \"\(.value.config.url)\"" else empty end),
              ""
        ' "$SERVERS_JSON"
        echo "$MARKER_END"
    } > "$fragment"

    mkdir -p "$(dirname "$destination")"
    if [[ -f "$destination" ]]; then
        # Remove the current managed block and legacy stanzas from older
        # versions of this repository.
        awk '
            $0 == "# BEGIN dotfiles-ai-mcp" { managed=1; next }
            $0 == "# END dotfiles-ai-mcp" { managed=0; next }
            /^\[mcp_servers\.(stitch|aws-mcp)\]$/ { legacy=1; next }
            /^\[/ { legacy=0 }
            !managed && !legacy { print }
        ' "$destination" > "$temporary"
        mv "$temporary" "$destination"
    else
        : > "$destination"
    fi

    printf '\n%s\n' "$(cat "$fragment")" >> "$destination"
    rm -f "$fragment" "$temporary"
    echo "MCP (codex): $destination"
}

main() {
    require_jq
    echo "Generating MCP configs from $SERVERS_JSON"
    write_json cursor "$AI_DIR/.cursor/mcp.json"
    write_json claude "$AI_DIR/.claude/mcp.json"
    link_agent_json "$AI_DIR/.cursor/mcp.json" "$HOME/.cursor/mcp.json"
    link_agent_json "$AI_DIR/.claude/mcp.json" "$HOME/.claude/mcp.json"
    sync_codex
    echo "MCP sync complete"
}

main "$@"
