#!/bin/sh
# Preserve machine-specific service variables; manage only T3's telemetry opt-out.
awk '
    /^[[:space:]]*(export[[:space:]]+)?T3CODE_TELEMETRY_ENABLED[[:space:]]*=/ {
        if (!seen++) print "T3CODE_TELEMETRY_ENABLED=false"
        next
    }
    { print }
    END { if (!seen) print "T3CODE_TELEMETRY_ENABLED=false" }
'
