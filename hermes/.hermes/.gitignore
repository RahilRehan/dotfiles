# Hermes runtime data is intentionally kept beside the managed configuration
# but never committed to the dotfiles repository.
*

# Tracked configuration and editable sources.
!.gitignore
!config.yaml
!SOUL.md
!slack-manifest.json
!.env.example
!cron/
!cron/jobs.json
!news/
!news/x/
!news/x/companies.yaml
!news/x/people.yaml
!skills/
!skills/**/
!skills/**/SKILL.md
!skills/**/scripts/
!skills/**/scripts/*.py
!docs/
!docs/**

# Explicit denials — these stay untracked even if the allowlist grows.
.env
auth.json
google_token.json
google_oauth_pending.json
google_oauth_last_url.txt
